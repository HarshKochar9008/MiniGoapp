<?xml version="1.0" encoding="utf-8"?>
<!--
  Android 12+ (API 31) backup / device-transfer rules. `allowBackup="false"` in
  the manifest already disables cloud backup; this closes the device-to-device
  transfer path, which allowBackup does not cover.

  Excluding everything is the correct behaviour for this app, not just the
  cautious one. A MiniGo identity is device-local by construction: the X25519
  private key lives in EncryptedSharedPreferences under a non-exportable
  Android Keystore master key, so it can never be part of a transfer. Carrying
  the *other* half over — short_code, user_db_id, auth_uid in
  FlutterSharedPreferences — would restore an identity whose private key is
  gone, i.e. a device advertising a code it can no longer decrypt files for
  (see E2ECrypto._loadKeyPair's "bad stored key pair" path). Starting clean on
  a new device is the intended outcome; the user gets a fresh code.
-->
<data-extraction-rules>
    <cloud-backup>
        <exclude domain="root" />
        <exclude domain="file" />
        <exclude domain="database" />
        <exclude domain="sharedpref" />
        <exclude domain="external" />
    </cloud-backup>
    <device-transfer>
        <exclude domain="root" />
        <exclude domain="file" />
        <exclude domain="database" />
        <exclude domain="sharedpref" />
        <exclude domain="external" />
    </device-transfer>
</data-extraction-rules>
