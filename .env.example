SUPABASE_URL=https://your-project-id.supabase.co
SUPABASE_ANON_KEY=your-anon-key-here


# Route file bytes through Cloudflare R2 instead of Supabase Storage
# (see docs/R2_SETUP.md). Requires the r2-sign-upload / r2-sign-download
# edge functions to be deployed with R2 secrets set; falls back to Supabase
# Storage automatically when they are not.
USE_R2_STORAGE=false
